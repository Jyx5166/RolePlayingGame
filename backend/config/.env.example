# 配置模板：仅在尚无 backend/config/.env 时，从仓库根目录执行
# Copy-Item backend\config\.env.example backend\config\.env
# 将真实密钥只保存在本机 .env；不要把 .env 提交到版本控制。
# 进程环境变量优先于 .env，修改后需重启服务。
# 游戏工作流配置单独位于 backend/config/workflow.yaml，不通过环境变量设置。

# 应用名称与运行环境（与 backend/app/config.py 的默认值一致）
APP_TITLE=剧镜 · AI 剧本杀
APP_ENV=development

# 不设置时，production 自动启用 Secure Cookie，其他环境关闭。
# 仅在明确需要覆盖时取消注释；Secure Cookie 需要通过 HTTPS 访问。
# COOKIE_SECURE=true

# 模型提供方：echo 为离线规则演示；openai_compatible 调用模型 API。
# echo 不发起外部模型请求，不能用于评价真实模型效果。
LLM_PROVIDER=echo

# 以下为本地 Ollama 的连接参考；只有 openai_compatible 会使用连接参数。
# 远程服务需同时替换模型名、API 根地址与密钥。
LLM_MODEL=qwen3-32b
# 客户端会追加 /chat/completions，此处不要填写完整接口路径。
LLM_BASE_URL=http://localhost:11434/v1
# ollama 是本地服务的示例占位；远程服务请在本机 .env 中填写真实密钥。
LLM_API_KEY=ollama

# 单次模型请求总等待上限（秒）
LLM_TIMEOUT_SECONDS=120

# 应用侧上下文预算，必须按所用模型的容量调整；不会自动识别真实窗口。
# 输入按 UTF-8 字节保守估算，提供方返回的实际 token 用量另行记录。
# 所有预算必须为正整数，输入上限 + 输出预留 + 安全余量 <= 总窗口。
LLM_CONTEXT_WINDOW=32768
LLM_INPUT_TOKEN_LIMIT=23000
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TOKEN_SAFETY_MARGIN=1024

# 留空时不向 API 发送 reasoning_effort；非空值须由所用模型 API 支持。
# 游戏中 workflow.yaml 的非空 reasoning_effort 会覆盖此项；创作流程也可覆盖。
LLM_REASONING_EFFORT=

# 监听地址与端口：启动器在加载 .env 前读取，必须在启动前设进程环境变量。
# PowerShell 示例：$env:APP_HOST='127.0.0.1'; $env:APP_PORT='8000'
# APP_HOST=127.0.0.1
# APP_PORT=8000
# 直接使用 uvicorn 时，请通过 --host 和 --port 指定监听地址及端口。

# 数据目录：未设置或为空时，源码模式使用 backend/data；
# 打包模式使用 %LOCALAPPDATA%/AIMurderMystery。
# 建议在启动前设进程环境变量，并使用绝对路径。
# 在 .env 中设置可改变后续数据目录，但不能改变本次已选定的 .env 文件位置。
# 打包时如需使用 <自定义数据目录>/config/.env，必须在启动前设置此变量。
# PowerShell 示例：$env:AI_MURDER_MYSTERY_DATA_DIR='D:\jujing-data'
# AI_MURDER_MYSTERY_DATA_DIR=

# 可在启动前指定另一份 .env 的绝对路径，必须设置在进程环境中。
# 把本变量写在 .env 内无法改变本次读取的配置文件位置。
# 未设置或为空时，源码默认读取 backend/config/.env；
# 打包默认读取 <数据目录>/config/.env。
# PowerShell 示例：$env:AI_MURDER_MYSTERY_ENV_FILE='D:\private\jujing.env'
# AI_MURDER_MYSTERY_ENV_FILE=
