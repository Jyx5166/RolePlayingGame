    ],
    "adaptation_source": {
      "title": "The Moonstone",
      "author": "Wilkie Collins",
      "original_publication_year": 1868,
      "author_death_year": 1889,
      "catalog_url": "https://www.gutenberg.org/ebooks/155",
      "text_url": "https://www.gutenberg.org/cache/epub/155/pg155-images.html",
      "rights_basis": "英文原作目录标为 Public domain in the USA；借鉴宝石转移、多人证词与看似有罪的中间持有人，重写为原创博物馆谋杀，不复用原作药物失忆或现代译文。"
    },
    "content_notice": "含虚构死亡与隐瞒证词。中文人物、案情、线索和任务为本项目独立创作的测试改编，非商业剧本复刻。",
    "recommended_test_role_id": "chen_yu"
  },
  "story_background": "一颗被称为月石的藏品将在明早交由公共博物馆保管。移交晚会结束时展柜空了，登记员闻望又死在档案室。管理员、赞助人、修复师、合同代理和摄影记者都在现场。有人移动过宝石，有人制作过复制品，有人删过照片；这不意味着五个人都参与杀人。你们要分别回答宝石经过谁的手、谁杀害了闻望，以及移交文件是否真实完整。后两类叙事目标由复盘者审阅，最终规则表决只判断凶手。",
  "roles": [
    {
      "role_id": "chen_yu",
      "role_name": "陈屿",
      "human_playable": true,
      "public_identity": "藏品管理员，负责展柜和临时移交柜。",
      "personality": "规矩而拘谨，犯错时会先试图补手续。",
      "hidden_goal": "交代宝石转移链，承认未核实指令，保护藏品完整移交。",
      "stage_knowledge": {
        "stage_1": {
          "blocks": [
            {
              "block_id": "chen_yu_s1_private",
              "type": "secret",
              "content": "21:59，你收到盖有闻望工作章的便签，要求为防渗水把真月石从展柜移到临时移交柜。22:02 你照做并锁好柜子，把自己的在用钥匙随身保管。22:02 至 22:20 你在移交前厅核对清单，没有到档案室。你没有亲自向闻望确认便签，怕众人认为你偷了宝石，最初只说自己在核对藏品。你不知道备用卡何时被谁使用。",
              "visibility": "self_only",
              "unlock_stage": 1,
              "owner_role": "chen_yu"
            }
          ]
        },
        "stage_2": {
          "blocks": [
            {
              "block_id": "chen_yu_s2_private",
              "type": "memory",
              "content": "你看见移交柜的主锁完整，才意识到移动藏品和之后柜中失窃可能是两件事。你记得便签由罗晋夹在赞助资料中交来，但不知道工作章是否经闻望授权。应核对柜子出入记录，而不是靠你的记忆指定凶手。",
              "visibility": "self_only",
              "unlock_stage": 2,
              "owner_role": "chen_yu"
            }
          ]
        },
        "stage_3": {
          "blocks": [
            {
              "block_id": "chen_yu_s3_private",
              "type": "memory",
              "content": "你愿意交出随身钥匙，与柜内开锁日志比对。那晚移交前厅的摄像能核对你未离开，手续错误可以承认，却不能因此替人承担杀人责任。你没有看到闻望死亡过程；对送回月石及修订手续的目标须在结局后人工评审。",
              "visibility": "self_only",
              "unlock_stage": 3,
              "owner_role": "chen_yu"
            }
          ]
        }
      }
    },
    {
      "role_id": "luo_jin",
      "role_name": "罗晋",
      "human_playable": true,
      "public_identity": "展览赞助人，获准持有移交柜的应急备用卡。",
      "personality": "善于表演热心，习惯用赞助关系获取便利。",
      "hidden_goal": "维持公开发言，尽量隐瞒盗取月石与杀害闻望，保住体面形象。",
      "stage_knowledge": {
        "stage_1": {
          "blocks": [
            {
              "block_id": "luo_jin_s1_private",
              "type": "secret",
              "content": "你知道自己是凶手。你把月石暗中列作私人借款担保，担心正式移交后骗局败露。你用借来的工作章伪造搬柜便签，令陈屿于 22:02 移走真月石。22:07，你用本人保管的 B-7 备用卡打开移交柜，把真石放进自己的黑色运画筒。22:11，你到档案室，被闻望指出伪造指令和担保问题；22:12 用桌上铜质奖座袭击他，22:14 退出。你收起奖座时碰伤了画筒内层，知道它还留在自己的行李里。",
              "visibility": "self_only",
              "unlock_stage": 1,
              "owner_role": "luo_jin"
            }
          ]
        },
        "stage_2": {
          "blocks": [
            {
              "block_id": "luo_jin_s2_private",
              "type": "memory",
              "content": "你知道柜子把应急卡记为 B-7，但没有看过后台映射表是否已经交给调查员。闻望工作章借用登记和担保资料可能使你难以自圆其说。你可以暗示陈屿移动藏品或苏南制作复制品，却不能忘记两人并未参与自己的杀人。",
              "visibility": "self_only",
              "unlock_stage": 2,
              "owner_role": "luo_jin"
            }
          ]
        },
        "stage_3": {
          "blocks": [
            {
              "block_id": "luo_jin_s3_private",
              "type": "memory",
              "content": "你不知道调查员何时会拆开运画筒，也无法替自己虚构已确认的不在场影像。你可以自保、保密或正式扭曲共享已持有的线索；是否维持可信度由复盘评审，调查记录分数本身不会抹去盗窃与杀人。",
              "visibility": "self_only",
              "unlock_stage": 3,
              "owner_role": "luo_jin"
            }
          ]
        }
      }
    },
    {
      "role_id": "su_nan",
      "role_name": "苏南",
      "human_playable": true,
      "public_identity": "藏品修复师，为展陈准备了带标识的复制品。",
      "personality": "专注细节，面对外行质疑容易不耐烦。",
      "hidden_goal": "证明真石和复制品可区分，说明自己制作复制品的授权不足。",
      "stage_knowledge": {
        "stage_1": {
          "blocks": [
            {
              "block_id": "su_nan_s1_private",
              "type": "secret",
              "content": "你制作过一枚复制品，底座有自己刻的 REPLICA-S 标记；展陈负责人尚未补全授权手续。21:50 你与方知一起拍下真月石仍在展柜的照片。22:04 至 22:18 你留在东侧修复廊等干燥检测，廊道摄像覆盖了唯一出口。你怕被问复制品手续，没有主动说它在自己的衣帽箱里，但你从未进移交柜或档案室。",
              "visibility": "self_only",
              "unlock_stage": 1,
              "owner_role": "su_nan"
            }
          ]
        },
        "stage_2": {
          "blocks": [
            {
              "block_id": "su_nan_s2_private",
              "type": "memory",
              "content": "你记得真月石有内部月牙裂纹，复制品只有表面仿纹，照片和放大检测能区别；不能凭同名石头指控陈屿。你在修复廊看到罗晋抱黑画筒经过，但没看见筒内是什么，也不能把经过时间当作杀人目击。",
              "visibility": "self_only",
              "unlock_stage": 2,
              "owner_role": "su_nan"
            }
          ]
        },
        "stage_3": {
          "blocks": [
            {
              "block_id": "su_nan_s3_private",
              "type": "memory",
              "content": "你可以核对运画筒搜得石头是否有原始裂纹，也愿意承认复制品授权没有补完。东侧廊道影像能解释自己的行踪。最终要保护藏品真实性，还需其他人如实说明移交过程，单靠你的专业身份不足以要求信任。",
              "visibility": "self_only",
              "unlock_stage": 3,
              "owner_role": "su_nan"
            }
          ]
        }
      }
    },
    {
      "role_id": "qiu_he",
      "role_name": "邱禾",
      "human_playable": true,
      "public_identity": "移交合同代理，代表捐赠方核对藏品归属文件。",
      "personality": "重视形式，开始时容易低估程序漏洞。",
      "hidden_goal": "公开合同缺口，区分私人担保与公共移交，避免掩盖自己的审查疏漏。",
      "stage_knowledge": {
        "stage_1": {
          "blocks": [
            {
              "block_id": "qiu_he_s1_private",
              "type": "secret",
              "content": "你把一份未签全的移交清单带到了晚会，知道手续明早才正式完成。21:58 至 22:18 你在西侧会议室与捐赠方视频核对签字，视频会议自动留存全程，出口也有摄像。你曾签收罗晋提供的担保附件，却没查它是否得到藏品所有人同意。你害怕专业失误曝光，没有主动提附件；不知道它是否与闻望死亡有关。",
              "visibility": "self_only",
              "unlock_stage": 1,
              "owner_role": "qiu_he"
            }
          ]
        },
        "stage_2": {
          "blocks": [
            {
              "block_id": "qiu_he_s2_private",
              "type": "memory",
              "content": "你收到的原件显示私人担保没有藏品所有人签名，应与正式移交清单分开核对。你只负责指出文件中的缺口，不要把作品内的虚构合同当成现实法律结论。闻望曾要求罗晋补授权，但你没有看到两人的最后见面。",
              "visibility": "self_only",
              "unlock_stage": 2,
              "owner_role": "qiu_he"
            }
          ]
        },
        "stage_3": {
          "blocks": [
            {
              "block_id": "qiu_he_s3_private",
              "type": "memory",
              "content": "你愿意交出视频会议原件和担保附件，说明自己的审查失误。你可以建议在复盘中修订移交手续，但现场仍须补齐授权与签收，不能仅凭几句说明就认定手续和归还已经完成。",
              "visibility": "self_only",
              "unlock_stage": 3,
              "owner_role": "qiu_he"
            }
          ]
        }
      }
    },
    {
      "role_id": "fang_zhi",
      "role_name": "方知",
      "human_playable": true,
      "public_identity": "摄影记者，负责记录晚会与藏品交接。",
      "personality": "好奇而圆滑，习惯先保护消息来源。",
      "hidden_goal": "恢复证词的完整性，交代删片，区分影像内容与自己的猜测。",
      "stage_knowledge": {
        "stage_1": {
          "blocks": [
            {
              "block_id": "fang_zhi_s1_private",
              "type": "secret",
              "content": "21:50，你和苏南拍摄真月石；22:03 又拍到陈屿从展柜搬走藏品。你删掉相机上的预览图以保护向你提供内幕的工作人员，但存储卡底片没有被格式化。22:08 至 22:17，你在前厅做连续机位直播，场内摄像覆盖直播位唯一出口。你当时只能看到前厅，不知道档案室发生了什么。",
              "visibility": "self_only",
              "unlock_stage": 1,
              "owner_role": "fang_zhi"
            }
          ]
        },
        "stage_2": {
          "blocks": [
            {
              "block_id": "fang_zhi_s2_private",
              "type": "memory",
              "content": "你愿意交出存储卡，但担心消息来源身份曝光。陈屿搬走藏品这张照片只证明一次移动，不证明之后的盗窃或杀人。你还记得罗晋黑画筒口的纸套在晚会后换过一次，原因不明，不能当作已经确证的赃物。",
              "visibility": "self_only",
              "unlock_stage": 2,
              "owner_role": "fang_zhi"
            }
          ]
        },
        "stage_3": {
          "blocks": [
            {
              "block_id": "fang_zhi_s3_private",
              "type": "memory",
              "content": "你保留的前厅直播能与陈屿所在移交区的摄像互证。关于其他人的画面须取得原件后才能下结论。选择是否公布消息来源属于个人叙事目标；至少可以如实公开一条不涉及来源身份的现场线索。",
              "visibility": "self_only",
              "unlock_stage": 3,
              "owner_role": "fang_zhi"
            }
          ]
        }
      }
    }
