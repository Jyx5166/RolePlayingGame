{
  "script_meta": {
    "script_id": "white_tower_guest",
    "title": "白塔来客",
    "total_stages": 3,
    "supported_skills": [
      "deduction"
    ],
    "adaptation_source": {
      "title": "The Adventure of the Speckled Band",
      "author": "Arthur Conan Doyle",
      "original_publication_year": 1892,
      "author_death_year": 1930,
      "catalog_url": "https://www.gutenberg.org/ebooks/1661",
      "text_url": "https://www.gutenberg.org/cache/epub/1661/pg1661-images.html",
      "rights_basis": "英文原作目录标为 Public domain in the USA；借鉴看似密室、房间连通与财产控制动机，改写为隐藏检修门，不使用原作毒蛇设定或现代译文。"
    },
    "content_notice": "含虚构死亡与隐瞒证词。中文人物、案情、线索和任务为本项目独立创作的测试改编，非商业剧本复刻。",
    "recommended_test_role_id": "ye_ming"
  },
  "story_background": "白塔疗养馆改建为海岸文化馆的前夜，项目负责人叶沅被发现死在反锁的阅览室。她的妹妹、家庭医师、维修工和登记员都留在馆内。白塔旧图纸多次改动，所谓密室是否真的无路可走尚不能确定。叶沅第二天将开始独立审计，其中既有工程账，也有长期由家庭医师代管的信托支出。地图、鉴定与监控分批整理；各幕仅能使用已经发放的事实。",
  "roles": [
    {
      "role_id": "ye_ming",
      "role_name": "叶茗",
      "human_playable": true,
      "public_identity": "叶沅的妹妹，白塔项目的共同受益人。",
      "personality": "倔强敏感，急于摆脱被安排的生活。",
      "hidden_goal": "查明姐姐遇害原因，同时承认自己的离馆计划并不等于杀人动机。",
      "stage_knowledge": {
        "stage_1": {
          "blocks": [
            {
              "block_id": "ye_ming_s1_private",
              "type": "secret",
              "content": "21:25，你因去留问题与姐姐争吵。21:35 她走入阅览室并反锁，你转去门房打长途电话。你拿过属于自己名下但由馆方保管的旅费，担心大家把这件事说成偷窃。你在电话中听见 21:42 左右传来一声短促惊呼，没看到来源。陆远常年代理信托，你只知道姐姐明天要独立审计，还不知道任何审计结果。",
              "visibility": "self_only",
              "unlock_stage": 1,
              "owner_role": "ye_ming"
            }
          ]
        },
        "stage_2": {
          "blocks": [
            {
              "block_id": "ye_ming_s2_private",
              "type": "memory",
              "content": "你记得上周姐姐说阅览室墙柜背后总有冷风，但这只是旧记忆，不能凭此确定那里有门。你可以请乔杉核对工程记录。你与姐姐争吵后并未回阅览室，门房电话和连续摄像应能核对；你没有亲手掌管陆远诊室的钥匙。",
              "visibility": "self_only",
              "unlock_stage": 2,
              "owner_role": "ye_ming"
            }
          ]
        },
        "stage_3": {
          "blocks": [
            {
              "block_id": "ye_ming_s3_private",
              "type": "memory",
              "content": "你核对过电话账单，21:37 至 21:48 的通话是自己与外地学校办理入学，不是与他人串供。账单内容需要你主动说明或搜证取得，其他角色不会自动知道。你知道自己只想离馆，不能据此猜测别人做过的事。",
              "visibility": "self_only",
              "unlock_stage": 3,
              "owner_role": "ye_ming"
            }
          ]
        }
      }
    },
    {
      "role_id": "lu_yuan",
      "role_name": "陆远",
      "human_playable": true,
      "public_identity": "叶家家庭医师，兼管白塔信托支出。",
      "personality": "克制有礼，常以长辈身份替别人决定。",
      "hidden_goal": "至少维持公开发言，尽量遮掩自己通过检修通路杀害叶沅的事实。",
      "stage_knowledge": {
        "stage_1": {
          "blocks": [
            {
              "block_id": "lu_yuan_s1_private",
              "type": "secret",
              "content": "你知道自己杀了叶沅。她发现你的信托支出异常，明晨独立审计会使你失去资金控制权。你知道诊室通往阅览室墙柜后有旧检修通路，12:00 以安全检查为名独自领走通路钥匙。21:38 进入诊室后，你在 21:41 通过检修门进入阅览室，用室内石质镇纸袭击叶沅，21:44 退回，21:46 离开诊室。阅览室正门一直由她从内反锁。你可以维持突发疾病说法，但不应把自己的罪行当成未知秘密。",
              "visibility": "self_only",
              "unlock_stage": 1,
              "owner_role": "lu_yuan"
            }
          ]
        },
        "stage_2": {
          "blocks": [
            {
              "block_id": "lu_yuan_s2_private",
              "type": "memory",
              "content": "你当天用新白漆封住检修门外缘，袖口沾过漆，曾替叶沅整理蓝色围巾。你不知道调查员将何时打开旧工程图或取得鉴定报告。通路钥匙始终由你持有，但你会尝试把注意力引向乔杉的维修工作或叶茗的旅费争执。",
              "visibility": "self_only",
              "unlock_stage": 2,
              "owner_role": "lu_yuan"
            }
          ]
        },
        "stage_3": {
          "blocks": [
            {
              "block_id": "lu_yuan_s3_private",
              "type": "memory",
              "content": "你知道诊室走廊有连续摄像，自己此前没有查看底片；无法声称已删除它。你可以对鉴定或影像提出疑问，却不能更改现存线索。决定哪些私有信息愿意公开是角色目标，调查记录分数不会替你证明无罪。",
              "visibility": "self_only",
              "unlock_stage": 3,
              "owner_role": "lu_yuan"
            }
          ]
        }
      }
    },
    {
      "role_id": "qiao_shan",
      "role_name": "乔杉",
      "human_playable": true,
      "public_identity": "维修工，负责白塔的墙柜与外侧楼梯施工。",
      "personality": "务实好强，害怕安全违规被追责。",
      "hidden_goal": "承认未报批的小修，核清工程通路与谁实际拿了钥匙。",
      "stage_knowledge": {
        "stage_1": {
          "blocks": [
            {
              "block_id": "qiao_shan_s1_private",
              "type": "secret",
              "content": "你白天修过阅览室墙柜，未等报批就补了门框松动处。12:00 陆远要求领走旧检修通路钥匙；你在钥匙柜登记后把钥匙交给他，并未保留副本。21:36 至 21:50 你在塔外铁梯接线，门房每隔数分钟通过工作对讲确认进度。21:42 听见惊呼时你停过一下，但不能从塔外看到阅览室。",
              "visibility": "self_only",
              "unlock_stage": 1,
              "owner_role": "qiao_shan"
            }
          ]
        },
        "stage_2": {
          "blocks": [
            {
              "block_id": "qiao_shan_s2_private",
              "type": "memory",
              "content": "工程档案里应有早年的检修通路图，你记得通路经过诊室而非塔外铁梯。你当天下午只修过正面门框，没有进入诊室端的通路。未报批的小修会让你难堪，但不是杀人事实。图纸一旦开放，应由现场搜证确认结构，而非请大家仅相信你的口述。",
              "visibility": "self_only",
              "unlock_stage": 2,
              "owner_role": "qiao_shan"
            }
          ]
        },
        "stage_3": {
          "blocks": [
            {
              "block_id": "qiao_shan_s3_private",
              "type": "memory",
              "content": "你确认钥匙柜封存后的照片中备用钥匙仍有原封签。21:36 至 21:50 的塔外影像能与工作对讲互证。你没有拿走被陆远领走的那把钥匙，也不知道他在诊室里具体做了什么；需要以门禁和物证作判断。",
              "visibility": "self_only",
              "unlock_stage": 3,
              "owner_role": "qiao_shan"
            }
          ]
        }
      }
    },
    {
      "role_id": "wen_xi",
      "role_name": "温汐",
      "human_playable": true,
      "public_identity": "文化馆登记员，负责访客登记与文件传递。",
      "personality": "认真寡言，面对冲突时容易先保全工作。",
      "hidden_goal": "公开被压下的文件线索，查清信托审计与死亡的关系。",
      "stage_knowledge": {
        "stage_1": {
          "blocks": [
            {
              "block_id": "wen_xi_s1_private",
              "type": "secret",
              "content": "你在 21:30 递给叶沅一封审计预约函。她请你次日把信托原账交给审计员。你曾替陆远补签一份没有附件的费用表，怕被查出失职。21:35 至 21:49 你一直在前厅给参观团办集体登记，双人签收与前厅摄像应能核对。21:46，你隔着走廊见陆远从诊室方向出来，不能确定他此前去了哪里。",
              "visibility": "self_only",
              "unlock_stage": 1,
              "owner_role": "wen_xi"
            }
          ]
        },
        "stage_2": {
          "blocks": [
            {
              "block_id": "wen_xi_s2_private",
              "type": "memory",
              "content": "你保存的预约函副联写明叶沅将终止代管授权，明天核对原账。你还没有看到最终审计，不能说陆远已经被法律认定有罪。你可以解释自己补签费用表的错误，与乔杉一起核对通路钥匙交接。",
              "visibility": "self_only",
              "unlock_stage": 2,
              "owner_role": "wen_xi"
            }
          ]
        },
        "stage_3": {
          "blocks": [
            {
              "block_id": "wen_xi_s3_private",
              "type": "memory",
              "content": "你愿意交出前厅签收原件。你见到陆远的时间以走廊钟为准，钟在当天验收时已经校时，无需凭空引入时差。你当时只看到了他离开诊室方向，是否进入阅览室仍需通路、鉴定和衣物证据互证。",
              "visibility": "self_only",
              "unlock_stage": 3,
              "owner_role": "wen_xi"
            }
          ]
        }
      }
    }
  ],
