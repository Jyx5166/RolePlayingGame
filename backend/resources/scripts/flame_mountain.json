  "truth": {
    "full_story": "红孩儿与孙悟空从冲突走向理解。观音在后期出现，引导红孩儿把骄傲转化为守护，最终火焰山留出通路。",
    "complete_timeline": {
      "stage_1": "孙悟空来到火焰山，红孩儿阻拦，双方互相试探。",
      "stage_2": "双方发现硬碰硬无效，观音来到附近观察局势。",
      "stage_3": "观音点破红孩儿执念，孙悟空给出台阶，红孩儿选择让路。"
    },
    "role_arcs": {
      "red_boy": "从逞强守山到理解守护的含义。",
      "monkey_king": "从急躁求胜到学会给对方台阶。",
      "guanyin": "从观察者成为引导者，促成和解。"
    }
