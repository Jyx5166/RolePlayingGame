# Deny by default: only public build inputs may leave this checkout.
**
!Dockerfile
!.dockerignore
!backend/
backend/*
!backend/requirements.txt
!backend/app/
!backend/app/**
!backend/config/
backend/config/*
!backend/config/workflow.yaml
!backend/resources/
!backend/resources/**
!frontend/
frontend/*
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/styles.css
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/scripts/
frontend/scripts/*
!frontend/scripts/sync-build.mjs
!frontend/src/
!frontend/src/**
!frontend/assets/
!frontend/assets/**

# Also exclude local files accidentally placed inside allowed directories.
**/node_modules/
**/__pycache__/
**/.pytest_cache/
**/*.py[cod]
**/.env
**/.env.*
**/*.env
**/*.db
**/*.db-*
**/*.sqlite*
**/*.log
**/*.pem
**/*.key

# Additional key containers and SSH key filenames.
**/*.p12
**/*.pfx
**/.ssh/
**/id_rsa
**/id_rsa.pub
**/id_dsa
**/id_dsa.pub
**/id_ecdsa
**/id_ecdsa.pub
**/id_ed25519
**/id_ed25519.pub
**/Y
**/Y.pub
