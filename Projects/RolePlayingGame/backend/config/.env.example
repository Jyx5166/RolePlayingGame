# FastAPI 和桌面启动器配置
# 应用显示名称
APP_TITLE=AI 剧本杀桌面端

# development 使用本地 HTTP Cookie；production 强制 Secure Cookie
APP_ENV=development
# 通常无需单独设置；生产环境也可显式设置为 true
COOKIE_SECURE=false

# 本地监听地址和端口
APP_HOST=127.0.0.1
APP_PORT=8000

# 可选的数据目录覆盖
# 留空时，源码模式使用 backend/data；
# 打包模式使用 %LOCALAPPDATA%/AIMurderMystery。
AI_MURDER_MYSTERY_DATA_DIR=

# 大模型配置
# LLM_PROVIDER 可选 echo 或 openai_compatible
LLM_PROVIDER=echo

# 模型名称
LLM_MODEL=qwen3-32b

# OpenAI-compatible API 地址
LLM_BASE_URL=http://localhost:11434/v1

# 单次模型请求最长等待秒数
LLM_TIMEOUT_SECONDS=120

# 应用侧总上下文预算；不是自动识别出的模型真实窗口，请按提供商规格配置
# 输入采用保守 UTF-8 字节估算，提供商返回的实际 tokens 单独审计
LLM_CONTEXT_WINDOW=32768
LLM_INPUT_TOKEN_LIMIT=23000
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TOKEN_SAFETY_MARGIN=1024
# 上述 输入上限 + 输出预留 + 安全余量 必须不超过总预算
# 留空保持提供商默认推理设置；DeepSeek 可配置 none 关闭推理
LLM_REASONING_EFFORT=

# API Key；真实密钥只能填写在本机 .env，不要填写在该模板中
LLM_API_KEY=ollama
