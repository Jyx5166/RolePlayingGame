# 复制为 docker.env，再从仓库根目录启动：
# docker compose --env-file docker.env up -d --build --wait
# docker.env 仅本地保留；不要填写真实密钥到这个模板中。

# 宿主机发布地址与端口；容器内始终监听 0.0.0.0:8000。
JUJING_BIND_ADDRESS=127.0.0.1
JUJING_PORT=8000

# 本机 HTTP 使用 development；通过 HTTPS 反向代理对外部署时改为 production。
# production 且未覆盖 COOKIE_SECURE 时自动使用 Secure Cookie。
APP_ENV=development
# COOKIE_SECURE=true

# 默认 Echo 离线演示，不调用外部模型。
LLM_PROVIDER=echo
LLM_MODEL=qwen3-32b
# 容器访问宿主机模型使用此地址；远程服务请替换为供应商 API 根地址。
# 不要使用 localhost 指代容器外的服务；此处不要追加 /chat/completions。
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_TIMEOUT_SECONDS=120

# 其他模型预算参数参考 backend/config/.env.example，可按需添加到 docker.env。
# 游戏工作流位于镜像中的 backend/config/workflow.yaml，修改后重新构建镜像。
# 容器数据目录由 Compose 固定为 /data，保存在命名卷中；不要填写宿主机路径。
